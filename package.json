{
  "name": "@edgetoken/core",
  "version": "1.0.1",
  "description": "Zero-dependency edge-ready JWT and PASETO v3 engine powered by Web Cryptography",
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "keywords": [
    "Edge",
    "Token",
    "JWT",
    "Paseto"
  ],
  "homepage": "https://lazosee.github.io/ts-edge-token/",
  "bugs": {
    "url": "https://github.com/lazosee/ts-edge-token/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lazosee/ts-edge-token.git"
  },
  "license": "MIT",
  "author": "Lazaro Osee <oseelazaro@gmail.com> (https://github.com/lazosee)",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm && tsc",
    "prepublishOnly": "npm run build",
    "docs:readme": "typedoc --options typedoc.readme.json && node scripts/update-readme.mjs",
    "docs:pages": "typedoc --options typedoc.html.json",
    "docs": "npm run docs:readme && npm run docs:pages"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
