{
  "name": "@edgetoken/core",
  "version": "1.0.0",
  "description": "Zero-dependency edge-ready JWT and PASETO v3 engine powered by Web Cryptography",
  "type": "module",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsc",
    "docs:readme": "typedoc --options typedoc.readme.json && node scripts/update-readme.mjs",
    "docs:pages": "typedoc --options typedoc.html.json",
    "docs": "npm run docs:readme && npm run docs:pages"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
